{
  "name": "jdr-ambiences",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:lan": "expo start --lan --clear",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile preview",
    "build:ipa": "eas build -p ios --profile preview",
    "build:android": "eas build -p android --profile preview",
    "build:android:prod": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile preview",
    "build:ios:prod": "eas build -p ios --profile production",
    "build:all": "eas build -p all --profile preview",
    "build:all:installable": "eas build -p all --profile preview",
    "build:all:prod": "eas build -p all --profile production",
    "submit:android": "eas submit -p android --latest",
    "submit:ios": "eas submit -p ios --latest",
    "builds:list": "eas build:list",
    "backend:start": "php -S 0.0.0.0:8000 -t backend/public backend/public/index.php",
    "backend:mongo:start": "node backend-mongo/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.7",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "mongodb": "^7.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
